# Copia este archivo a .env (gitignorado). IM_TOKEN es un JWT del usuario
# fantasma "claude" (role admin, login bloqueado); se genera firmando con el
# JWT_SECRET del backend: jwt.sign({ userId: 'claude' }, JWT_SECRET, { expiresIn: '365d' })
IM_API_URL=https://investments-manager-production.up.railway.app/api
IM_TOKEN=
